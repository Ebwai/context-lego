{
  "name": "dsh-conversation-tree",
  "version": "0.3.0",
  "description": "Tree conversations and reusable prompts for DeepSeek Harness",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-0 <0.3.0"
  },
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test tests/history.test.mjs",
    "check": "node --check src/index.js && node --check src/history.js && node --check src/client/index.js",
    "prepack": "npm run build",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2"
  }
}
